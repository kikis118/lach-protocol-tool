{
  "name": "lach-protokolu-riks",
  "productName": "LACH Protokolu Rīks",
  "private": true,
  "version": "0.3.12",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "lv.lach.protokolu-riks",
    "productName": "LACH Protokolu Rīks",
    "artifactName": "LACH-Protokolu-Riks-Setup.${ext}",
    "publish": {
      "provider": "github",
      "owner": "kikis118",
      "repo": "lach-protocol-tool",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@44.1.1": true
  }
}
